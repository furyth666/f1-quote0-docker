# Required. Keep real values only in your local .env file.
DOT_API_KEY=
QUOTE0_DEVICE_ID=

# Optional. CANVAS_TASK_KEY is normally auto-discovered from the device loop.
CANVAS_TASK_KEY=
CANVAS_TASK_ALIAS=F1 看板
F1_DRIVER_ID=
F1_CONSTRUCTOR_ID=

# Optional single-dashboard selector. When set, it overrides F1_DASHBOARDS.
# Use one of the 11 names documented in README.md, or use all for every dashboard.
F1_DASHBOARD=

# Optional ordered rotation. Comma-separated, duplicates and unknown values are ignored.
F1_DASHBOARDS=latestAllSession,nextSession
PUSH_INTERVAL_SECONDS=300
DATA_REFRESH_SECONDS=180
LIVE_REFRESH_SECONDS=15
TZ=UTC

# Optional outbound proxy. Uncomment and adjust only when your Docker host requires it.
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
